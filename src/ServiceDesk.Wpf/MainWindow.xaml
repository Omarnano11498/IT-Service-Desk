<Window x:Class="ServiceDesk.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ServiceDesk.Wpf.ViewModels"
        xmlns:views="clr-namespace:ServiceDesk.Wpf.Views"
        Title="IT Service Desk" Height="820" Width="1360" MinHeight="640" MinWidth="1100"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Brush.Background}"
        FontFamily="Segoe UI" FontSize="13">

    <!-- ViewModel-first navigation: each page ViewModel is rendered by its View via implicit DataTemplates -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:SubmitTicketViewModel}"><views:SubmitTicketView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TrackTicketViewModel}"><views:TrackTicketView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminLoginViewModel}"><views:AdminLoginView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminQueueViewModel}"><views:AdminQueueView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatisticsViewModel}"><views:StatisticsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== Sidebar / mode switcher ===================== -->
        <DockPanel Background="{StaticResource Brush.Sidebar}" LastChildFill="False">
            <StackPanel DockPanel.Dock="Top" Margin="16,20,16,0">
                <TextBlock Text="IT Service Desk" Foreground="White" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="{Binding ModeText}" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,18"/>

                <TextBlock Text="END USER" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,4"/>
                <Button Style="{StaticResource NavButton}" Content="📝  Submit a ticket" Command="{Binding ShowSubmitCommand}"/>
                <Button Style="{StaticResource NavButton}" Content="🔎  Track my ticket" Command="{Binding ShowTrackCommand}"/>

                <TextBlock Text="IT ADMINISTRATOR" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" Margin="4,18,0,4"/>
                <Button Style="{StaticResource NavButton}" Content="🔐  Administrator sign-in" Command="{Binding ShowAdminCommand}"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                <Button Style="{StaticResource NavButton}" Content="📋  Queue &amp; triage" Command="{Binding ShowQueueCommand}"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                <Button Style="{StaticResource NavButton}" Content="📊  Statistics &amp; evaluation" Command="{Binding ShowStatisticsCommand}"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                <Button Style="{StaticResource NavButton}" Content="⚙  Settings (SQL, SLA)" Command="{Binding ShowSettingsCommand}"
                        Visibility="{Binding CanOpenSettings, Converter={StaticResource BoolToVis}}"/>
                <Button Style="{StaticResource NavButton}" Content="⏻  Sign out" Command="{Binding LogoutCommand}"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <TextBlock DockPanel.Dock="Bottom" Text="{Binding ConnectionTarget}" Foreground="#94A3B8" FontSize="11"
                       TextWrapping="Wrap" Margin="16,0,16,16"/>
        </DockPanel>

        <!-- ===================== Content ===================== -->
        <Grid Grid.Column="1" Margin="24,18,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding CurrentPage.Title}"/>
            <ProgressBar Grid.Row="1" Height="3" IsIndeterminate="True" Margin="0,2,0,8" BorderThickness="0"
                         Foreground="{StaticResource Brush.Primary}" Background="Transparent"
                         Visibility="{Binding CurrentPage.IsBusy, Converter={StaticResource BoolToVis}}"/>
            <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" Focusable="False"/>
        </Grid>
    </Grid>
</Window>
