<UserControl x:Class="ServiceDesk.Wpf.Views.SubmitTicketView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                       Text="No sign-in needed. Describe the problem, choose how urgent it is and how many people it affects — the system assigns the priority and SLA automatically."/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>

                <!-- Requester -->
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="1. Your contact details"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Full name *"/>
                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" MaxLength="120"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="E-mail *"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="254"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Phone"/>
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" MaxLength="30"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Department"/>
                        <TextBox Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"/>
                    </StackPanel>
                </Border>

                <!-- Ticket -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="2. Your request"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Category *"/>
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name"/>
                        <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" Text="{Binding SelectedCategory.Description}"/>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Urgency (how soon?)"/>
                                <ComboBox ItemsSource="{Binding Urgencies}" SelectedItem="{Binding Urgency}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Impact (how many affected?)"/>
                                <ComboBox ItemsSource="{Binding Impacts}" SelectedItem="{Binding Impact}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Resulting priority"/>
                                <Border Style="{StaticResource Badge}" Margin="0,4,0,0" Background="{Binding PreviewPriority, Converter={StaticResource BadgeBrush}}">
                                    <TextBlock Style="{StaticResource BadgeText}" FontSize="13" Text="{Binding PreviewPriority}"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Subject *"/>
                        <TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Description *"/>
                        <TextBox Style="{StaticResource MultiLine}" MinHeight="110" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="8000"/>

                        <!-- Polymorphic, category-specific fields -->
                        <Grid Visibility="{Binding ShowHardware, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Device type * (laptop, printer…)"/>
                                <TextBox Text="{Binding DeviceType, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Asset tag"/>
                                <TextBox Text="{Binding AssetTag, UpdateSourceTrigger=PropertyChanged}" MaxLength="50"/>
                            </StackPanel>
                        </Grid>
                        <Grid Visibility="{Binding ShowSoftware, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Application name *"/>
                                <TextBox Text="{Binding ApplicationName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Version"/>
                                <TextBox Text="{Binding ApplicationVersion, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"/>
                            </StackPanel>
                        </Grid>
                        <Grid Visibility="{Binding ShowNetwork, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Location / segment * (building, floor, VPN…)"/>
                                <TextBox Text="{Binding NetworkLocation, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Affected IP address"/>
                                <TextBox Text="{Binding AffectedIpAddress, UpdateSourceTrigger=PropertyChanged}" MaxLength="45"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource ErrorBox}" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.Error}" TextWrapping="Wrap"/>
            </Border>
            <Border Style="{StaticResource SuccessBox}" Visibility="{Binding LastTicketNumber, Converter={StaticResource NullToVis}}">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brush.Success}">
                        <Run Text="Your ticket number: "/><Run Text="{Binding LastTicketNumber, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Style="{StaticResource PrimaryButton}" Content="Submit ticket" Command="{Binding SubmitCommand}" IsDefault="True"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Clear form" Command="{Binding ClearCommand}"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Reload categories" Command="{Binding LoadCategoriesCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
