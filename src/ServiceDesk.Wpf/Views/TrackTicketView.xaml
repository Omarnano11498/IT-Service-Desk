<UserControl x:Class="ServiceDesk.Wpf.Views.TrackTicketView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Muted}" Text="Enter your ticket number and the e-mail you used when submitting. Both are required to protect your privacy."/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <StackPanel Width="200" Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Ticket number (e.g. TKT-0000042 or 42)"/>
                        <TextBox Text="{Binding TicketNumber, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Width="280" Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="E-mail"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <Button Style="{StaticResource PrimaryButton}" Content="Look up" VerticalAlignment="Bottom"
                            Command="{Binding LookupCommand}" IsDefault="True"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource ErrorBox}" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.Error}" TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="2" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Ticket.TicketNumber}" Margin="0,0,10,0"/>
                                <Border Style="{StaticResource Badge}" Background="{Binding Ticket.Status, Converter={StaticResource BadgeBrush}}" Margin="0,0,6,8">
                                    <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Ticket.Status, Converter={StaticResource EnumDisplay}}"/>
                                </Border>
                                <Border Style="{StaticResource Badge}" Background="{Binding Ticket.Priority, Converter={StaticResource BadgeBrush}}" Margin="0,0,6,8">
                                    <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Ticket.Priority}"/>
                                </Border>
                                <Border Style="{StaticResource Badge}" Background="{Binding CurrentSlaState, Converter={StaticResource BadgeBrush}}" Margin="0,0,6,8">
                                    <TextBlock Style="{StaticResource BadgeText}" Text="{Binding CurrentSlaState, Converter={StaticResource EnumDisplay}, StringFormat='SLA: {0}'}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Ticket.Subject}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Ticket.CategoryName}" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding Ticket.Description}" TextWrapping="Wrap" Margin="0,8,0,0"/>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Muted}" Text="Submitted"/>
                                <TextBlock Grid.Column="1" Text="{Binding Ticket.CreatedAt, Converter={StaticResource UtcToLocal}}"/>
                                <TextBlock Grid.Row="1" Style="{StaticResource Muted}" Text="Received by IT"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Ticket.FirstResponseAt, Converter={StaticResource UtcToLocal}}"/>
                                <TextBlock Grid.Row="2" Style="{StaticResource Muted}" Text="Target resolution"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Ticket.ResolutionDueAt, Converter={StaticResource UtcToLocal}}"/>
                                <TextBlock Grid.Row="3" Style="{StaticResource Muted}" Text="Handled by"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Ticket.AssignedAdminName, TargetNullValue='Not yet assigned'}"/>
                                <TextBlock Grid.Row="4" Style="{StaticResource Muted}" Text="Resolved"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Ticket.ResolvedAt, Converter={StaticResource UtcToLocal}}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SuccessBox}" Visibility="{Binding Ticket.ResolutionNotes, Converter={StaticResource NullToVis}}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Resolution"/>
                            <TextBlock Text="{Binding Ticket.ResolutionNotes}" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="{Binding Ticket.RootCause, StringFormat='Root cause: {0}'}"/>
                        </StackPanel>
                    </Border>

                    <!-- Satisfaction rating -->
                    <Border Style="{StaticResource Card}" Visibility="{Binding CanRate, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="How satisfied are you with the service?"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox Width="80" ItemsSource="{Binding RatingOptions}" SelectedItem="{Binding Rating}" Margin="0,0,8,0"/>
                                <TextBlock Text="/ 5" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBox Width="320" Text="{Binding RatingComment, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000"/>
                                <Button Style="{StaticResource SuccessButton}" Content="Send rating" Margin="8,0,0,0" Command="{Binding RateCommand}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                                       Visibility="{Binding Evaluation, Converter={StaticResource NullToVis}}">
                                <Run Text="Current service evaluation: "/><Run Text="{Binding Evaluation.OverallScore, Mode=OneWay}"/><Run Text=" / 100 — "/><Run Text="{Binding Evaluation.Grade, Mode=OneWay, Converter={StaticResource EnumDisplay}}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding StatusMessage}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Public timeline (internal admin notes are excluded server-side) -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Updates from IT"/>
                    <ListView ItemsSource="{Binding History}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4,0,8">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Summary}"/>
                                    <TextBlock Style="{StaticResource Muted}" FontSize="11">
                                        <Run Text="{Binding OccurredAt, Mode=OneWay, Converter={StaticResource UtcToLocal}}"/><Run Text="  •  "/><Run Text="{Binding PerformedByName, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Notes}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
