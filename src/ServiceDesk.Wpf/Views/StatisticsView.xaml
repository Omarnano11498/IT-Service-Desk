<UserControl x:Class="ServiceDesk.Wpf.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="KpiCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
            <!-- Toolbar -->
            <Border Style="{StaticResource Card}" Padding="12">
                <WrapPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,3" Text="From (created)"/>
                        <DatePicker SelectedDate="{Binding FromDate}" Width="140"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,3" Text="To (inclusive)"/>
                        <DatePicker SelectedDate="{Binding ToDate}" Width="140"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource PrimaryButton}" Content="Compute" Command="{Binding RefreshCommand}"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="Export CSV" Command="{Binding ExportCsvCommand}"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="Export JSON" Command="{Binding ExportJsonCommand}"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="Recalculate evaluations" Command="{Binding RecalculateCommand}"
                                ToolTip="Re-scores every resolved ticket (run once after the seed script, or after changing the formula)."/>
                    </StackPanel>
                </WrapPanel>
            </Border>

            <Border Style="{StaticResource ErrorBox}" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.Error}" TextWrapping="Wrap"/>
            </Border>
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8" Text="{Binding StatusMessage}"/>

            <StackPanel Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                <!-- KPI tiles -->
                <UniformGrid Columns="6">
                    <Border Style="{StaticResource KpiCard}"><StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Text="Total tickets"/>
                        <TextBlock Style="{StaticResource KpiValue}" Text="{Binding Report.Total}"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource KpiCard}"><StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Text="Open (in progress / pending)"/>
                        <TextBlock Style="{StaticResource KpiValue}">
                            <Run Text="{Binding Report.Open, Mode=OneWay}"/><Run FontSize="13" FontWeight="Normal" Text="  ("/><Run FontSize="13" FontWeight="Normal" Text="{Binding Report.InProgress, Mode=OneWay}"/><Run FontSize="13" FontWeight="Normal" Text=" / "/><Run FontSize="13" FontWeight="Normal" Text="{Binding Report.Pending, Mode=OneWay}"/><Run FontSize="13" FontWeight="Normal" Text=")"/>
                        </TextBlock>
                    </StackPanel></Border>
                    <Border Style="{StaticResource KpiCard}"><StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Text="Resolved / closed"/>
                        <TextBlock Style="{StaticResource KpiValue}" Text="{Binding Report.ResolvedOrClosed}"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource KpiCard}"><StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Text="Resolution SLA compliance"/>
                        <TextBlock Style="{StaticResource KpiValue}" Text="{Binding Report.SlaCompliancePercent, StringFormat={}{0:0.#}%}"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource KpiCard}"><StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Text="Response SLA compliance"/>
                        <TextBlock Style="{StaticResource KpiValue}" Text="{Binding Report.ResponseCompliancePercent, StringFormat={}{0:0.#}%}"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource KpiCard}"><StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Text="Service health index"/>
                        <TextBlock Style="{StaticResource KpiValue}" Text="{Binding Report.ServiceHealthIndex, StringFormat={}{0:0.#}}"/>
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding Report.ServiceHealthLabel}"/>
                    </StackPanel></Border>
                </UniformGrid>

                <!-- Solution time -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Solution (resolution) time — hours"/>
                        <UniformGrid Columns="7">
                            <StackPanel><TextBlock Style="{StaticResource Muted}" Text="Resolved"/><TextBlock Style="{StaticResource KpiValue}" FontSize="18" Text="{Binding Report.Resolution.Count}"/></StackPanel>
                            <StackPanel><TextBlock Style="{StaticResource Muted}" Text="Mean"/><TextBlock Style="{StaticResource KpiValue}" FontSize="18" Text="{Binding Report.Resolution.MeanHours}"/></StackPanel>
                            <StackPanel><TextBlock Style="{StaticResource Muted}" Text="Median"/><TextBlock Style="{StaticResource KpiValue}" FontSize="18" Text="{Binding Report.Resolution.MedianHours}"/></StackPanel>
                            <StackPanel><TextBlock Style="{StaticResource Muted}" Text="Min"/><TextBlock Style="{StaticResource KpiValue}" FontSize="18" Text="{Binding Report.Resolution.MinHours}"/></StackPanel>
                            <StackPanel><TextBlock Style="{StaticResource Muted}" Text="Max"/><TextBlock Style="{StaticResource KpiValue}" FontSize="18" Text="{Binding Report.Resolution.MaxHours}"/></StackPanel>
                            <StackPanel><TextBlock Style="{StaticResource Muted}" Text="P90"/><TextBlock Style="{StaticResource KpiValue}" FontSize="18" Text="{Binding Report.Resolution.P90Hours}"/></StackPanel>
                            <StackPanel><TextBlock Style="{StaticResource Muted}" Text="Std-dev"/><TextBlock Style="{StaticResource KpiValue}" FontSize="18" Text="{Binding Report.Resolution.StdDevHours}"/></StackPanel>
                        </UniformGrid>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0">
                            <Run Text="Time to first response — mean "/><Run Text="{Binding Report.FirstResponse.MeanHours, Mode=OneWay}"/><Run Text=" h, median "/><Run Text="{Binding Report.FirstResponse.MedianHours, Mode=OneWay}"/><Run Text=" h.  Open tickets breached: "/><Run Text="{Binding Report.OpenBreached, Mode=OneWay}"/><Run Text=", at risk: "/><Run Text="{Binding Report.OpenAtRisk, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Breakdowns -->
                <UniformGrid Columns="2">
                    <Border Style="{StaticResource Card}" Margin="0,0,10,12"><StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="By category"/>
                        <ItemsControl ItemsSource="{Binding ByCategory}" ItemTemplate="{StaticResource BreakdownBar}"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="By priority"/>
                        <ItemsControl ItemsSource="{Binding ByPriority}" ItemTemplate="{StaticResource BreakdownBar}"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,12"><StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="By administrator"/>
                        <ItemsControl ItemsSource="{Binding ByAdministrator}" ItemTemplate="{StaticResource BreakdownBar}"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="By status"/>
                        <ItemsControl ItemsSource="{Binding ByStatus}" ItemTemplate="{StaticResource BreakdownBar}"/>
                    </StackPanel></Border>
                </UniformGrid>

                <!-- Service evaluation -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}">
                            <Run Text="Service evaluation — mean score "/><Run Text="{Binding Report.MeanEvaluationScore, Mode=OneWay}"/><Run Text=" / 100"/>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding ByGrade}" ItemTemplate="{StaticResource BreakdownBar}" Margin="0,0,0,10"/>
                        <TextBlock Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="11" Text="{Binding FormulaText}" Margin="0,0,0,10"/>
                        <DataGrid ItemsSource="{Binding Evaluations}" MaxHeight="360">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ticket" Binding="{Binding TicketNumber}" Width="100"/>
                                <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="80"/>
                                <DataGridTextColumn Header="Administrator" Binding="{Binding AdminName}" Width="*"/>
                                <DataGridTextColumn Header="Resolution (h)" Binding="{Binding ResolutionHours}" Width="100"/>
                                <DataGridTextColumn Header="Speed" Binding="{Binding SpeedScore}" Width="70"/>
                                <DataGridTextColumn Header="Quality" Binding="{Binding QualityScore}" Width="70"/>
                                <DataGridTextColumn Header="Overall" Binding="{Binding OverallScore}" Width="70"/>
                                <DataGridTemplateColumn Header="Grade" Width="110" SortMemberPath="Grade">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Badge}" Background="{Binding Grade, Converter={StaticResource BadgeBrush}}">
                                                <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Grade, Converter={StaticResource EnumDisplay}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Rating" Binding="{Binding SatisfactionRating, TargetNullValue='—'}" Width="60"/>
                                <DataGridTextColumn Header="Evaluated" Binding="{Binding EvaluatedAt, Converter={StaticResource UtcToLocal}}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
