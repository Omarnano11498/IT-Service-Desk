    <RootNamespace>ServiceDesk.Wpf</RootNamespace>
    <AssemblyName>ServiceDesk</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ServiceDesk.Domain\ServiceDesk.Domain.csproj" />
    <ProjectReference Include="..\ServiceDesk.Application\ServiceDesk.Application.csproj" />
    <ProjectReference Include="..\ServiceDesk.Data\ServiceDesk.Data.csproj" />
  </ItemGroup>
</Project>
